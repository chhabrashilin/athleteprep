# ─────────────────────────────────────────────────────────────────────────────
# GameIQ — Environment Variables
# Copy this file to .env.local and fill in the values.
# Never commit .env.local or any file with real secrets.
# See /docs/ENVIRONMENT.md for full documentation.
# See /docs/SUPABASE_SETUP.md for Supabase project setup.
# See /docs/PILOT_ENVIRONMENT_PRESETS.md for preset configs per deployment type.
# ─────────────────────────────────────────────────────────────────────────────

# ─── App Identity ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=GameIQ

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECURITY: SUPABASE_SERVICE_ROLE_KEY bypasses RLS. Server-side ONLY.
# Never prefix with NEXT_PUBLIC_. Never commit to git.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Storage Buckets ──────────────────────────────────────────────────────────
# Must match the bucket names created in Supabase Storage (all private).
NEXT_PUBLIC_STORAGE_BUCKET=game-videos
NEXT_PUBLIC_THUMBNAIL_BUCKET=game-thumbnails
REPORT_EXPORT_BUCKET=report-exports

# ─── AI Provider ──────────────────────────────────────────────────────────────
# Options: mock | openai | anthropic | gemini
# Default "mock" — no API calls, zero cost, deterministic output for development.
# WARNING: Enabling real AI in production incurs per-token costs.
#   Set a monthly spend cap in your provider dashboard BEFORE enabling.
AI_PROVIDER=mock

# API keys — server-side only. NEVER use NEXT_PUBLIC_ prefix for these.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Model overrides (optional — defaults shown)
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-haiku-latest
GEMINI_MODEL=gemini-1.5-flash

# ─── Feature Flags ────────────────────────────────────────────────────────────
# NEXT_PUBLIC_ prefix required — these flags are read by both server and client.

# Enable the /demo/setup demo workspace creation flow.
# true  → Founder demo deployment (creates a pre-built sample team and report)
# false → Coach pilot / production (coaches use their own real data)
NEXT_PUBLIC_ENABLE_MOCK_DATA=false

# Enable real AI report generation. Requires AI_PROVIDER + matching API key.
# false → Always use mock AI (zero cost, safe default for pilot)
# true  → Use the configured real AI provider (incurs API costs)
NEXT_PUBLIC_ENABLE_REAL_AI=false

# Enable server-side video processing (thumbnails, duration extraction).
# false → Not implemented in v1. Leave false.
NEXT_PUBLIC_ENABLE_VIDEO_PROCESSING=false

# Show admin analytics/feedback nav links for ADMIN_EMAILS users.
# true  → Show links (access still gated by ADMIN_EMAILS below)
# false → Hide links
NEXT_PUBLIC_ENABLE_FOUNDER_ANALYTICS=true

# Show the public /feedback and /request-access pages.
# true  → Visible (recommended — collecting coach feedback is always useful)
# false → Hidden
NEXT_PUBLIC_ENABLE_PUBLIC_FEEDBACK=true

# Show a "Pilot MVP" badge in the app header during structured pilot sessions.
# true  → Badge visible (sets coach expectations proactively)
# false → No badge (cleaner for demos)
NEXT_PUBLIC_PILOT_MODE=false

# ─── Multi-Sport & Cricket Feature Flags ─────────────────────────────────────
# Enable multi-sport platform mode (shows sport selection, sport registry).
NEXT_PUBLIC_MULTI_SPORT_ENABLED=true

# Enable the Cricket Hub and cricket foundation routes (/cricket, /cricket/leagues, etc.).
NEXT_PUBLIC_CRICKET_ENABLED=true

# Cricket sub-features — all off by default; enable as each module ships.
# Social feed / community features
NEXT_PUBLIC_CRICKET_SOCIAL_ENABLED=false

# Live streaming overlay integration (overlay_only mode ships by default)
NEXT_PUBLIC_CRICKET_STREAMING_ENABLED=true

# Broadcast overlay system: OBS/vMix/Streamlabs browser-source overlays
NEXT_PUBLIC_CRICKET_BROADCAST_OVERLAYS_ENABLED=true

# ─── Cricket Streaming Provider ───────────────────────────────────────────────
# overlay_only = fully supported, no external provider required.
# external_embed = user supplies a public embed URL (YouTube, Facebook Live, etc.)
# custom_rtmp = requires CRICKET_STREAM_RTMP_INGEST_URL + secure stream key storage.
# youtube / twitch = disabled unless YOUTUBE_LIVE_ENABLED / TWITCH_LIVE_ENABLED=true
#   with matching client credentials.
CRICKET_STREAM_PROVIDER=overlay_only
CRICKET_STREAM_RTMP_INGEST_URL=
CRICKET_STREAM_PROVIDER_WEBHOOK_SECRET=

# YouTube Live integration (disabled by default — requires OAuth client credentials)
YOUTUBE_LIVE_ENABLED=false
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Twitch integration (disabled by default — requires OAuth client credentials)
TWITCH_LIVE_ENABLED=false
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# ─── Overlay Settings ─────────────────────────────────────────────────────────
# How often overlay pages poll for fresh data (milliseconds). Default: 2000ms.
NEXT_PUBLIC_OVERLAY_REFRESH_INTERVAL_MS=2000
# Default overlay theme applied when no custom theme is configured.
NEXT_PUBLIC_OVERLAY_DEFAULT_THEME=classic

# ─── Cricket Commerce & Marketplace (Prompt 38) ──────────────────────────────
# Equipment/merchandise marketplace (vendor catalog, product listings).
NEXT_PUBLIC_CRICKET_MARKETPLACE_ENABLED=true

# Team kit inquiry/order request flow.
NEXT_PUBLIC_CRICKET_TEAM_KIT_ORDERS_ENABLED=true

# Sponsorship package listings and inquiries.
NEXT_PUBLIC_CRICKET_SPONSORSHIP_ENABLED=true

# Vendor self-service portal (apply, manage products, view orders).
NEXT_PUBLIC_CRICKET_VENDOR_PORTAL_ENABLED=true

# ─── Commerce Checkout Provider ───────────────────────────────────────────────
# CRICKET_CHECKOUT_PROVIDER controls how orders are processed.
#   request_only (default) — no payment processing; all orders are inquiries/requests.
#   stripe                 — Stripe Checkout redirect (requires keys below + CRICKET_PAYMENTS_ENABLED=true).
# Catalog browsing and order requests work in ALL modes with no extra config.
CRICKET_CHECKOUT_PROVIDER=request_only
CRICKET_PAYMENTS_ENABLED=false

# Stripe — optional. Only used when CRICKET_CHECKOUT_PROVIDER=stripe AND CRICKET_PAYMENTS_ENABLED=true.
# SECURITY: STRIPE_SECRET_KEY is server-side only. Never use NEXT_PUBLIC_ prefix.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Commerce Policy Defaults ─────────────────────────────────────────────────
# Require league/admin to approve vendors before they appear publicly.
CRICKET_COMMERCE_REQUIRE_PRODUCT_APPROVAL=true
CRICKET_COMMERCE_REQUIRE_VENDOR_APPROVAL=true
# Allow the public marketplace (/cricket/store) to be visible without login.
CRICKET_COMMERCE_ALLOW_PUBLIC_MARKETPLACE=true
# Default currency code (ISO 4217).
CRICKET_COMMERCE_DEFAULT_CURRENCY=USD
# Max product images a vendor can upload per product.
CRICKET_COMMERCE_MAX_PRODUCT_IMAGES=8
# Max quantity a buyer can order in a single line item.
CRICKET_COMMERCE_MAX_ORDER_QUANTITY=999

# News, trivia, polls module
NEXT_PUBLIC_CRICKET_NEWS_ENABLED=true

# Ball-by-ball live scoring interface
NEXT_PUBLIC_CRICKET_LIVE_SCORING_ENABLED=false

# Advanced analytics (wagon wheel, Manhattan graph, worm chart, run-rate)
NEXT_PUBLIC_CRICKET_ADVANCED_ANALYTICS_ENABLED=false

# ─── Cricket Community & Fan Engagement (Prompt 37) ──────────────────────────
# Community spaces, posts, comments, reactions, announcements, and feeds.
NEXT_PUBLIC_CRICKET_COMMUNITY_ENABLED=true

# First-party news articles and league announcements.
# (External news ingestion is provider-gated; disabled by default.)
NEXT_PUBLIC_CRICKET_NEWS_ENABLED=true

# Fan polls: create, vote, close, and display results.
NEXT_PUBLIC_CRICKET_POLLS_ENABLED=true

# Per-match fan discussion threads with moderation and slow-mode.
NEXT_PUBLIC_CRICKET_MATCH_THREADS_ENABLED=true

# In-app notification center (no external provider required).
NEXT_PUBLIC_CRICKET_IN_APP_NOTIFICATIONS_ENABLED=true

# ─── External Content Providers (disabled by default) ────────────────────────
# External news ingestion — only enable if a licensed provider is configured.
CRICKET_EXTERNAL_NEWS_ENABLED=false
CRICKET_NEWS_PROVIDER=
# SECURITY: Provider API keys are server-side only. Never use NEXT_PUBLIC_ prefix.
CRICKET_NEWS_PROVIDER_API_KEY=

# ─── Email / Push Notification Providers (disabled by default) ───────────────
# In-app notifications work without these. Only enable when provider is set up.
CRICKET_EMAIL_NOTIFICATIONS_ENABLED=false
CRICKET_PUSH_NOTIFICATIONS_ENABLED=false

# ─── Community Moderation Defaults ───────────────────────────────────────────
# Automatically flag posts matching safety rules for moderator review.
CRICKET_AUTO_MODERATION_ENABLED=true
# Require moderator approval before media-containing posts are visible.
CRICKET_REQUIRE_MEDIA_APPROVAL=true
# Maximum character length for community posts.
CRICKET_MAX_POST_LENGTH=3000
# Maximum character length for comments and thread messages.
CRICKET_MAX_COMMENT_LENGTH=1000

# ─── Admin / Analytics ────────────────────────────────────────────────────────
# Comma-separated list of emails that can access /admin/analytics and /admin/feedback.
# Example: founder@example.com,cofounder@example.com
# If empty, all admin pages deny access.
ADMIN_EMAILS=

# ─── Testing ──────────────────────────────────────────────────────────────────
# Unit and component tests (npm run test) require no env vars.
# E2E tests (npm run test:e2e) require the dev server running and:
#   NEXT_PUBLIC_ENABLE_MOCK_DATA=true   (enables demo workspace creation)
#   AI_PROVIDER=mock                    (no real API calls during E2E)
# Full authenticated E2E requires a real Supabase test project.
# See /docs/TESTING_STRATEGY.md for details.
