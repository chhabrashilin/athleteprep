# ─────────────────────────────────────────────────────────────────────────────
# GameIQ — Environment Variables
# Copy this file to .env.local and fill in the values.
# Never commit .env.local or any file with real secrets.
# See /docs/ENVIRONMENT.md for full documentation.
# See /docs/SUPABASE_SETUP.md for Supabase project setup.
# See /docs/PILOT_ENVIRONMENT_PRESETS.md for preset configs per deployment type.
# ─────────────────────────────────────────────────────────────────────────────

# ─── App Identity ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=GameIQ

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECURITY: SUPABASE_SERVICE_ROLE_KEY bypasses RLS. Server-side ONLY.
# Never prefix with NEXT_PUBLIC_. Never commit to git.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Storage Buckets ──────────────────────────────────────────────────────────
# Must match the bucket names created in Supabase Storage (all private).
NEXT_PUBLIC_STORAGE_BUCKET=game-videos
NEXT_PUBLIC_THUMBNAIL_BUCKET=game-thumbnails
REPORT_EXPORT_BUCKET=report-exports

# ─── AI Provider ──────────────────────────────────────────────────────────────
# Options: mock | openai | anthropic | gemini
# Default "mock" — no API calls, zero cost, deterministic output for development.
# WARNING: Enabling real AI in production incurs per-token costs.
#   Set a monthly spend cap in your provider dashboard BEFORE enabling.
AI_PROVIDER=mock

# API keys — server-side only. NEVER use NEXT_PUBLIC_ prefix for these.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Model overrides (optional — defaults shown)
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-haiku-latest
GEMINI_MODEL=gemini-1.5-flash

# ─── Feature Flags ────────────────────────────────────────────────────────────
# NEXT_PUBLIC_ prefix required — these flags are read by both server and client.

# Enable the /demo/setup demo workspace creation flow.
# true  → Founder demo deployment (creates a pre-built sample team and report)
# false → Coach pilot / production (coaches use their own real data)
NEXT_PUBLIC_ENABLE_MOCK_DATA=false

# Enable real AI report generation. Requires AI_PROVIDER + matching API key.
# false → Always use mock AI (zero cost, safe default for pilot)
# true  → Use the configured real AI provider (incurs API costs)
NEXT_PUBLIC_ENABLE_REAL_AI=false

# Enable server-side video processing (thumbnails, duration extraction).
# false → Not implemented in v1. Leave false.
NEXT_PUBLIC_ENABLE_VIDEO_PROCESSING=false

# Show admin analytics/feedback nav links for ADMIN_EMAILS users.
# true  → Show links (access still gated by ADMIN_EMAILS below)
# false → Hide links
NEXT_PUBLIC_ENABLE_FOUNDER_ANALYTICS=true

# Show the public /feedback and /request-access pages.
# true  → Visible (recommended — collecting coach feedback is always useful)
# false → Hidden
NEXT_PUBLIC_ENABLE_PUBLIC_FEEDBACK=true

# Show a "Pilot MVP" badge in the app header during structured pilot sessions.
# true  → Badge visible (sets coach expectations proactively)
# false → No badge (cleaner for demos)
NEXT_PUBLIC_PILOT_MODE=false

# ─── Multi-Sport & Cricket Feature Flags ─────────────────────────────────────
# Enable multi-sport platform mode (shows sport selection, sport registry).
NEXT_PUBLIC_MULTI_SPORT_ENABLED=true

# Enable the Cricket Hub and cricket foundation routes (/cricket, /cricket/leagues, etc.).
NEXT_PUBLIC_CRICKET_ENABLED=true

# Cricket sub-features — all off by default; enable as each module ships.
# Social feed / community features
NEXT_PUBLIC_CRICKET_SOCIAL_ENABLED=false

# Live streaming overlay integration
NEXT_PUBLIC_CRICKET_STREAMING_ENABLED=false

# Equipment / merchandise marketplace
NEXT_PUBLIC_CRICKET_MARKETPLACE_ENABLED=false

# News, trivia, polls module
NEXT_PUBLIC_CRICKET_NEWS_ENABLED=false

# Ball-by-ball live scoring interface
NEXT_PUBLIC_CRICKET_LIVE_SCORING_ENABLED=false

# Advanced analytics (wagon wheel, Manhattan graph, worm chart, run-rate)
NEXT_PUBLIC_CRICKET_ADVANCED_ANALYTICS_ENABLED=false

# ─── Admin / Analytics ────────────────────────────────────────────────────────
# Comma-separated list of emails that can access /admin/analytics and /admin/feedback.
# Example: founder@example.com,cofounder@example.com
# If empty, all admin pages deny access.
ADMIN_EMAILS=

# ─── Testing ──────────────────────────────────────────────────────────────────
# Unit and component tests (npm run test) require no env vars.
# E2E tests (npm run test:e2e) require the dev server running and:
#   NEXT_PUBLIC_ENABLE_MOCK_DATA=true   (enables demo workspace creation)
#   AI_PROVIDER=mock                    (no real API calls during E2E)
# Full authenticated E2E requires a real Supabase test project.
# See /docs/TESTING_STRATEGY.md for details.
