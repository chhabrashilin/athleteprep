# ─────────────────────────────────────────────────────────────────────────────
# GameIQ — Environment Variables
# Copy this file to .env.local and fill in the values.
# Never commit .env.local or any file with real secrets.
# See /docs/ENVIRONMENT.md for full documentation.
# See /docs/SUPABASE_SETUP.md for Supabase project setup.
# ─────────────────────────────────────────────────────────────────────────────

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=GameIQ

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Storage Buckets ──────────────────────────────────────────────────────────
# Must match the bucket names created in Supabase Storage
NEXT_PUBLIC_STORAGE_BUCKET=game-videos
NEXT_PUBLIC_THUMBNAIL_BUCKET=game-thumbnails
REPORT_EXPORT_BUCKET=report-exports

# ─── AI Provider ──────────────────────────────────────────────────────────────
# Options: mock | openai | anthropic | gemini
# Default is "mock" — no API calls, realistic structured output for development.
AI_PROVIDER=mock

# API keys — server-side only, never use NEXT_PUBLIC_ prefix
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Model overrides (optional — defaults shown below)
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-haiku-latest
GEMINI_MODEL=gemini-1.5-flash

# ─── Feature Flags ────────────────────────────────────────────────────────────
NEXT_PUBLIC_ENABLE_MOCK_DATA=true
# Set to true to enable real AI calls (requires AI_PROVIDER + matching API key)
NEXT_PUBLIC_ENABLE_REAL_AI=false
NEXT_PUBLIC_ENABLE_VIDEO_PROCESSING=false
